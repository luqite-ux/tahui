# Sanity（复用旧项目或新建项目后填入）
# 在 https://www.sanity.io/manage 创建/选择项目，并创建 dataset（如 production）
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# 服务端写入（如网站询盘提交到 Sanity）：在项目 API → Tokens 新建 Token，权限选 Editor，填到下面
# 仅服务端使用，不要加 NEXT_PUBLIC_，否则会暴露到前端
SANITY_API_WRITE_TOKEN=

# 可选：draft 预览、webhook 等
# SANITY_API_READ_TOKEN=
# SANITY_REVALIDATE_SECRET=
